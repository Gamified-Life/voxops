# Everything below is optional — VoxOps runs with zero configuration
# (npm install && npm start). Copy this to .env only if you want to change
# a default.

# Server
PORT=4000

# Session signing. Falls back to a dev secret if unset — set a real one
# before this ever runs somewhere other than your own machine.
JWT_SECRET=

# n8n (workflow automation). Leave blank to keep deployed workflows local-only
# — they still save and show up under Workflows, just marked "not delivered".
N8N_WEBHOOK_URL=
